# Mapillary client access token (https://www.mapillary.com/dashboard/developers). Only the photo scripts use it.
MAPILLARY_TOKEN=

# Upstash Redis via the Vercel Marketplace (vercel integration add upstash). Injected automatically on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret for signing game tokens.
GAME_SECRET=

# Optional Google sign-in (Better Auth). Session cookie secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
